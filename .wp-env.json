{
	"core": "WordPress/WordPress#6.9-branch",
	"phpVersion": "8.3",
	"plugins": [
		"."
	],
	"port": 8080,
	"testsPort": 8090,
	"lifecycleScripts": {
		"afterCleanup": "sh bin/mailpit.sh remove"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "local"
	},
	"env": {
		"development": {
			"mappings": {
				"wp-content/mu-plugins": "./bin/dev-mail"
			}
		}
	}
}

#, php-format
msgid "%1$s sent you a link to add a passkey to your account on %2$s."
msgstr "%1$s vous a envoyé un lien pour ajouter une clé d’accès à votre compte sur %2$s."

#: src/class-passkeys.php:266
msgid "Open it on the device that will store the passkey. It works once and expires in one hour."
msgstr "Ouvrez-le sur l’appareil qui conservera la clé d’accès. Il ne fonctionne qu’une fois et expire dans une heure."


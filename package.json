{
	"name": "azwp-passkeys",
	"private": true,
	"scripts": {
		"start": "sh bin/mailpit.sh start && wp-env start",
		"stop": "wp-env stop && sh bin/mailpit.sh stop",
		"reset": "wp-env cleanup && pnpm start",
		"reset:tests": "wp-env reset tests",
		"logs": "wp-env logs",
		"wp": "wp-env run cli wp",
		"i18n": "sh bin/i18n.sh",
		"bump": "sh bin/bump.sh",
		"dist": "sh bin/dist.sh",
		"test": "pnpm reset:tests && pnpm test:js && pnpm test:php && pnpm test:http && pnpm test:browser",
		"test:js": "node tests/client.cjs && node tests/blocks.cjs",
		"test:php": "sh bin/test-php.sh",
		"test:http": "AZWP_PASSKEYS_TESTS=1 TEST_URL=http://localhost:8090 node tests/http.cjs",
		"test:browser": "sh bin/test-browser.sh"
	},
	"devDependencies": {
		"@wordpress/env": "^12.1.0"
	},
	"packageManager": "pnpm@10.0.0",
	"engines": {
		"node": ">=22.13.0"
	},
	"pnpm": {
		"overrides": {
			"@wordpress/env>rimraf": "6.1.4",
			"@wp-playground/cli@3.1.62>express": "4.22.3",
			"@wp-playground/storage>isomorphic-git": "1.44.12"
		}
	}
}
